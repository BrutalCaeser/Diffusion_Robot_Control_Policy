# ==============================================================================
# .gitignore for Diffusion Policy Project
# ==============================================================================

# ---- Node.js (pptx generation) ----
node_modules/
package-lock.json
package.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ---- Virtual Environment ----
# Use leading slash to match ONLY top-level venv directories,
# not diffusion_policy/env/ (our source code).
/venv/
/.venv/
/env/

# ---- Claude local memory (not for repo) ----
.claude/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---- Data (too large for git) ----
# Use /data/ with leading slash to match ONLY the top-level data/ directory
# (where the Zarr dataset lives), NOT diffusion_policy/data/ (our Python source).
/data/
*.zarr
*.zarr/
*.hdf5
*.h5
*.pkl
*.pickle

# ---- Model Checkpoints (too large for git) ----
checkpoints/
*.pt
*.pth
*.ckpt

# ---- Training Logs & Outputs ----
logs/
runs/
wandb/
outputs/
*.log
# Evaluation results (JSON) go in results/ which is tracked

# ---- Jupyter Notebooks (optional: track .ipynb but ignore checkpoints) ----
.ipynb_checkpoints/

# ---- Miscellaneous ----
*.mp4
*.gif
*.png
*.jpg
!docs/*.png
!docs/*.jpg
# Track the generated presentation
!Diffusion_Policy_PushT.pptx

# Track key result plots (not GIFs, not per-episode frames)
!plots/multimodal_motivation.png
!plots/final_comparison.png
!plots/steps_ablation.png
!plots/training_curves/ddpm_300ep.png
!plots/training_curves/fm_300ep.png
!plots/training_curves/ddpm_vs_fm_300ep.png
!plots/dataset/dataset_summary.png
!plots/process/diffusion_forward_process.png

# macOS resource forks
._*
